{
  "name": "nc-main-chat-remote-phone",
  "version": "0.3.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "postinstall": "node scripts/apply-native-audio-patches.cjs",
    "start": "expo start",
    "go": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-expo-go.ps1",
    "go:fast": "expo start --go --lan --port 8081",
    "go:tunnel": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-expo-go.ps1 -Tunnel",
    "android": "expo start --go --lan --android",
    "ios": "expo start --ios",
    "start:ios-dev": "expo start --dev-client --lan",
    "web": "expo start --web"
  },
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-audio"
        ]
      }
    }
  },
  "dependencies": {
    "@config-plugins/react-native-webrtc": "^13.0.0",
    "@nc-relay/protocol": "file:../../packages/nc-relay-protocol",
    "buffer": "^6.0.3",
    "expo": "~54.0.35",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-camera": "~17.0.10",
    "expo-crypto": "~15.0.8",
    "expo-dev-client": "~6.0.21",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.23",
    "expo-image-picker": "~17.0.11",
    "expo-keep-awake": "~15.0.7",
    "expo-media-library": "~18.2.1",
    "expo-network": "~8.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-video": "~3.0.16",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-webrtc": "124.0.8",
    "react-native-worklets": "0.5.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/react": "~19.1.17",
    "typescript": "~5.9.2"
  }
}
