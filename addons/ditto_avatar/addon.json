{
  "id": "nc.ditto_avatar",
  "name": "Ditto Avatar",
  "category": "avatar",
  "version": "0.1.0",
  "entry_point": "main.py",
  "description": "Ditto avatar engine with its own Python environment and local desktop playback.",
  "permissions": ["ui.tabs", "services.register"],
  "runtime_defaults": {
    "ditto_repo_path": "Ditto",
    "ditto_python_path": "", "ditto_avatar_path": "", "ditto_emotion": "Neutral",
    "ditto_expression": 1.0, "ditto_motion": "Automatic", "ditto_relative": true,
    "ditto_eyes": "Automatic", "ditto_blink_style": "Checkpoint blink sequence",
    "ditto_conditioning": "Source face", "ditto_steps": 50, "ditto_smoothing": 3,
    "ditto_pitch_strength": 1.0, "ditto_yaw_strength": 1.0,
    "ditto_roll_strength": 1.0, "ditto_translation_strength": 1.0,
    "ditto_blink_open": 0, "ditto_pitch_offset": 2.0,
    "ditto_yaw_offset": 0.0, "ditto_roll_offset": 0.0,
    "ditto_fade_in": 0, "ditto_fade_out": 0,
    "ditto_fade_target": "Initial generated pose",
    "ditto_fade_keys": "Expression only",
    "ditto_eye_first_frame": false, "ditto_stitching": true,
    "ditto_seed": "", "ditto_source_smoothing": 13,
    "ditto_pack_id": "", "ditto_variant_id": "", "ditto_avatar_selection": "Fixed",
    "ditto_emotion_selection": "Manual", "ditto_test_emotion": "neutral", "ditto_enabled_pack_emotions": {}
  },
  "services": [{"id": "avatar_provider_registry", "provider_id": "ditto", "metadata": {}}],
  "host_services": [],
  "ui": [{"id": "ditto_avatar_tab", "title": "Ditto", "area": "top_level", "order": 125,
    "tooltip": "Ditto avatar settings, model lifetime and local preview.",
    "metadata": {"provider_id": "ditto"}}],
  "enabled": true,
  "native_qml": true
}
