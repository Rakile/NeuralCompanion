{
  "id": "nc.audio_story_mode",
  "name": "Audio Story Mode",
  "category": "visuals",
  "version": "0.1.1",
  "entry_point": "main.py",
  "description": "Import story audio, turn JSON chatlogs into resumable novels, or narrate Markdown chapters with local-first Audio Story tools.",
  "permissions": [
    "ui.tabs",
    "storage.read",
    "storage.write"
  ],
  "runtime_defaults": {
    "audio_story_analysis_mode": "scene_only"
  },
  "host_services": [
    {
      "id": "qt.audio_story_actions",
      "module": "addons.audio_story_mode.host_service",
      "class": "QtAudioStoryActionService"
    }
  ],
  "ui": [
    {
      "id": "audio_story_mode_runtime",
      "title": "Audio Story Mode",
      "area": "top_level",
      "ui_path": "ui/audio_story_mode.ui",
      "placeholder": "audio_story_mode_tab",
      "icon_path": "../../ui_icons/side_tabs/story_visuals.png",
      "order": 120,
      "tooltip": "Use audio stories, the Chatlog Novel Workshop, Markdown narration, and synchronized visual replies.",
      "metadata": {
        "runtime_role": "audio_story",
        "real_ui_bridge_module": "addons.audio_story_mode.real_ui_bridge"
      }
    }
  ],
  "enabled": true
}
