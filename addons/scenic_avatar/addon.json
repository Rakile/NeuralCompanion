{
  "id": "nc.scenic_avatar",
  "name": "Scenic Avatar",
  "category": "avatar",
  "version": "0.1.0",
  "entry_point": "main.py",
  "description": "Simple tag-to-image avatar engine using portable Scenic Packs.",
  "permissions": [
    "ui.tabs"
  ],
  "runtime_defaults": {
    "scenic_pack_id": ""
  },
  "services": [
    {
      "id": "avatar_provider_registry",
      "provider_id": "scenic",
      "metadata": {
        "kind": "avatar",
        "native_qml": true
      }
    }
  ],
  "ui": [
    {
      "id": "scenic_avatar_tab",
      "title": "Scenic Avatar",
      "area": "top_level",
      "order": 130,
      "tooltip": "Discover, select, and preview Scenic avatar packs.",
      "metadata": {
        "native_qml": true,
        "provider_id": "scenic"
      }
    }
  ],
  "enabled": true
}
